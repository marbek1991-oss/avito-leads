{
  "manifest_version": 3,
  "name": "Авито Лиды — аудит карточек",
  "version": "0.2.0",
  "description": "Передаёт данные открытого объявления Авито в Авито Лиды на этом компьютере",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.avito.ru/*",
    "https://avito.ru/*",
    "https://marbek1991-oss.github.io/avito-leads/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/*",
        "https://avito.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://marbek1991-oss.github.io/avito-leads/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}