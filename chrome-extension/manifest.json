{
  "manifest_version": 3,
  "name": "Авито Лиды — аудит карточек",
  "version": "0.1.0",
  "description": "Считывает доступный текст открытой карточки Авито для локального аудита в Авито Лиды",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.avito.ru/*",
    "https://avito.ru/*",
    "https://marbek1991-oss.github.io/avito-leads/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/*",
        "https://avito.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}